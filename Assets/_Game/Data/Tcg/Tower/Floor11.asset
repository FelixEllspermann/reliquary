  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor11
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Odile, the Loom Keeper
  eyebrow: "FLOOR XI \xB7 THE LOOM"
  blurb: "Mana control. Odile ramps to the Loom of Fate and the Hour Merchant \u2014
    end it before her seventh Mana."
  portrait: {fileID: 0}
  opponent: {fileID: 11400000, guid: 4241b871e764c45458be7359b00adee6, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: ODILE
    text: "I wove your climb into the loom last night \u2014 before you began it.
      Would you like to see the thread?"
  - speaker: ODILE
    text: 'Fourteen knots below the top. Every knot a Keeper. And here is the strange
      part, climber: the thread you chase...'
  - speaker: ODILE
    text: ...has never taken a single step. It has no knots at all. It simply waits
      at the top, where it has always been.
  - speaker: YOU
    text: Then the top is where I finish this.
  - speaker: ODILE
    text: 'Perhaps. First: my knot. The loom insists on order.'
  victoryLine: "The knot is tied. Climb, climber. And when you reach the top and
    understand \u2014 be kinder about it than I would be."
