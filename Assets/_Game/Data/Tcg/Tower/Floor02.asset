  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor02
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Serah of the Threshold
  eyebrow: "FLOOR II \xB7 THE THRESHOLD"
  blurb: Frost and Light, played by the book. Serah guards the first true seal and
    does not forgive sloppy attacks.
  portrait: {fileID: 21300000, guid: 218573f29e3016146a764d20f68fb78c, type: 3}
  opponent: {fileID: 11400000, guid: a87e5b7631f00ed47908d9efd520adba, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: SERAH
    text: "The Gatekeeper let you through. He lets everyone through \u2014 that is
      his flaw, not mine."
  - speaker: SERAH
    text: I held this threshold when your grandparents were not yet born. The seal
      behind me has never so much as flickered.
  - speaker: YOU
    text: It is flickering now.
  - speaker: SERAH
    text: "Yes. And that is why you will show me everything you have \u2014 politely,
      and in proper turn order."
  victoryLine: "Proper. Even elegant, in places. The threshold is yours to pass \u2014
    the Tower grows less patient from here."
