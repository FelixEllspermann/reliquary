  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor10
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Grett, the Flesh Binder
  eyebrow: "FLOOR X \xB7 THE SUTURE WARD"
  blurb: "Equip midrange. Grett stitches Artifacts onto everything \u2014 break the
    equipped monster before the Apex Chimera wakes."
  portrait: {fileID: 0}
  opponent: {fileID: 11400000, guid: 25f3f733efce2cc409c6e0503c07d3df, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: GRETT
    text: Halfway, little climber. Ten floors of Keepers, and every one of them woke
      the same night. Does that not strike you as... stitched together?
  - speaker: YOU
    text: Stitched by whom?
  - speaker: GRETT
    text: That is the question, yes. A good seam is invisible. You only find it by
      pulling.
  - speaker: GRETT
    text: So pull. Beat me, and the Tower will have to show you its seams.
  victoryLine: "Well pulled. You have renewed ten seals, duelist \u2014 the Tower
    has never seen the like. Whatever waits above has surely noticed."
