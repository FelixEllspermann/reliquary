  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor09
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Forgemaster Brann
  eyebrow: "FLOOR IX \xB7 THE COLD FORGE"
  blurb: "Forgeheart artifacts. Brann builds his board like a machine \u2014 break
    the Artifacts before the Worldanvil drops."
  portrait: {fileID: 0}
  opponent: {fileID: 11400000, guid: 85b729fee322f88449ed67dffaf1b5c9, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: BRANN
    text: Quiet. Listen. That hum is my forge lighting itself for the first time
      in a century. I did not light it.
  - speaker: BRANN
    text: A forge does not light itself. A seal does not wake itself. SOMEONE is
      working this tower like a bellows.
  - speaker: YOU
    text: That is why I am climbing.
  - speaker: BRANN
    text: "Then show me your work, duelist. I only respect what is properly made
      \u2014 and I test everything I respect."
  victoryLine: "Sound work. Solid joins. Whoever taught you, thank them. Now go \u2014
    and tell the one working the bellows that Brann noticed."
