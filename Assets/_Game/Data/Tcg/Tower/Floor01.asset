  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor01
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: The Gatekeeper
  eyebrow: "FLOOR I \xB7 THE DOORSTEP"
  blurb: "The first seal is a lesson. The Gatekeeper plays openly and never reacts
    on your turn \u2014 learn the Tower's rhythm."
  portrait: {fileID: 0}
  opponent: {fileID: 11400000, guid: b69aeb951e5b4ca408875ccaa5c4d000, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: GATEKEEPER
    text: "A visitor. The Tower has not heard footsteps in a hundred years \u2014
      and tonight it hears two sets."
  - speaker: YOU
    text: Two?
  - speaker: GATEKEEPER
    text: The lights above woke before you arrived. Whoever passed me never opened
      my door. Curious, isn't it?
  - speaker: GATEKEEPER
    text: Rules are rules all the same. The first seal is a duel, and I am its Keeper.
      Show me the vault still teaches its duelists.
  victoryLine: "The seal holds. Climb, duelist \u2014 and if you meet the one who
    walks without footsteps, duel them twice as hard."
