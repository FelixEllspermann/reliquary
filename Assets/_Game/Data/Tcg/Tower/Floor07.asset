  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor07
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Aliya, the Sky Herald
  eyebrow: "FLOOR VII \xB7 THE OPEN GALLERY"
  blurb: "Wind tempo. Aliya cycles fast and strikes from above \u2014 interrupt her
    draws or the Held Breath ends it in one gust."
  portrait: {fileID: 21300000, guid: be8dd24aa434388478d7a2edb8cc17f6, type: 3}
  opponent: {fileID: 11400000, guid: d97d6d069049e2c4ca2351a74b254acf, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: ALIYA
    text: I watch the outside of the Tower. Every window, every ledge. Nothing has
      climbed the outside in a hundred years.
  - speaker: YOU
    text: Then it climbed the inside.
  - speaker: ALIYA
    text: "The inside passes through six Keepers who saw nothing, and me \u2014 and
      I see everything."
  - speaker: ALIYA
    text: So either something climbs that cannot be seen... or nothing climbs at
      all. Beat me, and think hard about which is worse.
  victoryLine: "The wind says you fight honestly. Take the stairs. And duelist \u2014
    start asking who BENEFITS from a tower full of woken Keepers."
