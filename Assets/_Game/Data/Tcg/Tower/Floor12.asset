  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor12
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Seraph of the Twelfth Seal
  eyebrow: "FLOOR XII \xB7 THE LIGHT WELL"
  blurb: "Heavenly control. The Seraph stalls behind high DEF and crowns the board
    with the Empyrean \u2014 bring answers for 3200 ATK."
  portrait: {fileID: 21300000, guid: 218573f29e3016146a764d20f68fb78c, type: 3}
  opponent: {fileID: 11400000, guid: 30c49eac0dcc0884a8e2a8a1830794ce, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: SERAPH
    text: I have guarded this floor in perfect faith. Nothing passed me. I would
      swear it on the light itself.
  - speaker: YOU
    text: Every Keeper below says the same.
  - speaker: SERAPH
    text: Then either thirteen guardians lie... or the thing we guard against has
      been above us all along.
  - speaker: SERAPH
    text: "My faith cracks, duelist. Duel me before it breaks entirely \u2014 a Keeper
      should fall believing in SOMETHING."
  victoryLine: "So it was never below. Forgive me \u2014 I must sit with this. The
    last stairs are behind the light. Walk slowly. Arrive angry."
