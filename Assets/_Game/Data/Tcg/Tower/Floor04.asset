  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor04
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Maren, the Tide Caller
  eyebrow: "FLOOR IV \xB7 THE DROWNED HALL"
  blurb: Tidebound control. Maren bounces your monsters back to your hand and lets
    the empty board drown you.
  portrait: {fileID: 0}
  opponent: {fileID: 11400000, guid: 0eca8d60b53353a48a2b60d7df77d1ee, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: MAREN
    text: Mind the steps. The fourth floor has been underwater since the sea-relic
      stirred in its sleep.
  - speaker: MAREN
    text: The one who carried it up here never came back down. The water remembers
      her. I keep it company.
  - speaker: YOU
    text: The seal is failing, Maren. I can renew it.
  - speaker: MAREN
    text: "Then you will do it properly \u2014 through me. The sea returns everything
      eventually. Let us see if it returns you."
  victoryLine: "The water is calm again. She would have liked you, I think. Climb
    \u2014 before I change my mind about the calm."
