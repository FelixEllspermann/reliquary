  m_Script: {fileID: 11500000, guid: c59dde34364dc8344b540bfa7435e706, type: 3}
  m_Name: Floor05
  m_EditorClassIdentifier: Assembly-CSharp::Rouge.Tcg.TowerFloorDefinition
  keeperName: Gravekeeper Morwen
  eyebrow: "FLOOR V \xB7 THE OSSUARY"
  blurb: Gravemaw recursion. Morwen fills the graveyards fast and summons the Bottomless
    from four banished monsters.
  portrait: {fileID: 21300000, guid: b17307f48364a934b9ef8e53862585b2, type: 3}
  opponent: {fileID: 11400000, guid: 6a5c9a3b5693e5f4b885eef24210b7af, type: 2}
  lifePointsOverride: 0
  bonusManaPerTurn: 0
  dialog:
  - speaker: MORWEN
    text: We were not expecting company. We were not expecting anything. That is
      rather the point of an ossuary.
  - speaker: YOU
    text: We?
  - speaker: MORWEN
    text: "The dead beneath this floor, duelist. They woke before you came \u2014
      all of them, at once, like a held breath let go."
  - speaker: MORWEN
    text: They want to see you duel. We do not refuse the dead. Neither will you.
  victoryLine: "The dead are satisfied. We are... impressed. The stairs are behind
    the third pillar \u2014 mind where you step. They notice."
